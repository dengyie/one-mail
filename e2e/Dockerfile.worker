FROM node:24-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

WORKDIR /app

# Build from the workspace manifests and the committed workspace lockfile.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY worker/package.json worker/package.json
COPY worker/patches/ worker/patches/
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --filter @one-mail/worker... --frozen-lockfile

COPY packages/shared/ packages/shared/
RUN pnpm --filter @one-mail/shared build

COPY worker/src/ worker/src/
COPY worker/tsconfig.json worker/
ARG WRANGLER_TOML=e2e/fixtures/wrangler.toml.e2e
COPY ${WRANGLER_TOML} worker/wrangler.toml

WORKDIR /app/worker

EXPOSE 8787

CMD ["pnpm", "exec", "wrangler", "dev", "--port", "8787", "--ip", "0.0.0.0"]
